{
  "info": {
    "_postman_id": "e9fd2eb5-8c74-4da4-8db2-3a20ed758718",
    "name": "Enterprise HR ERP Microservices",
    "description": "Requests for the Department, Employee, Attendance, Reporting, and Notification services through the API Gateway. Set accessToken and replace the sample entity IDs before running the collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test(\"Response status is successful\", function () {",
          "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
          "});",
          "",
          "pm.test(\"Response is JSON\", function () {",
          "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Departments",
      "description": "Create, update, assign manager, and query department records.",
      "item": [
        {
          "name": "Create Department",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/departments/create",
            "description": "Creates a department and saves the returned ID to departmentId. Requires ADMIN or HR_MANAGER role.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{departmentName}}\",\n  \"description\": \"{{departmentDescription}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const response = pm.response.json();",
                  "    if (response.data && response.data.id) {",
                  "        pm.collectionVariables.set(\"departmentId\", response.data.id);",
                  "    }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Department",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/departments/update/{{departmentId}}",
            "description": "Updates the selected department. Run Create Department first or set departmentId manually. Requires ADMIN or HR_MANAGER role.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{departmentName}}\",\n  \"description\": \"{{departmentDescription}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Assign Department Manager",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": "{{baseUrl}}/api/departments/{{departmentId}}/manager?managerId={{managerId}}",
            "description": "Assigns a manager user to the selected department. Requires ADMIN or HR_MANAGER role."
          },
          "response": []
        },
        {
          "name": "Find Department By ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/departments/find/{{departmentId}}",
            "description": "Returns one department by ID."
          },
          "response": []
        },
        {
          "name": "Find All Departments",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/departments/findall",
            "description": "Returns all department records."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Employees",
      "description": "Create, update, update status, update department, and query employee records.",
      "item": [
        {
          "name": "Create Employee",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/employees/create",
            "description": "Creates an employee and saves the returned ID to employeeId. Requires ADMIN or HR_MANAGER role.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": \"{{userId}}\",\n  \"employee_number\": \"{{employeeNumber}}\",\n  \"first_name\": \"{{employeeFirstName}}\",\n  \"last_name\": \"{{employeeLastName}}\",\n  \"email\": \"{{employeeEmail}}\",\n  \"department_id\": \"{{departmentId}}\",\n  \"manager_employee_id\": \"{{managerEmployeeId}}\",\n  \"hire_date\": \"{{hireDate}}\",\n  \"status\": \"{{employeeStatus}}\",\n  \"version\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const response = pm.response.json();",
                  "    if (response.data && response.data.id) {",
                  "        pm.collectionVariables.set(\"employeeId\", response.data.id);",
                  "    }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Find Employee By ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/employees/findById?id={{employeeId}}",
            "description": "Returns one employee by ID."
          },
          "response": []
        },
        {
          "name": "Find All Employees",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/employees/findAll",
            "description": "Returns all employee records."
          },
          "response": []
        },
        {
          "name": "Update Employee",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/employees/update/{{employeeId}}",
            "description": "Updates the selected employee. Requires ADMIN or HR_MANAGER role.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": \"{{userId}}\",\n  \"employee_number\": \"{{employeeNumber}}\",\n  \"first_name\": \"{{employeeFirstName}}\",\n  \"last_name\": \"{{employeeLastName}}\",\n  \"email\": \"{{employeeEmail}}\",\n  \"department_id\": \"{{departmentId}}\",\n  \"manager_employee_id\": \"{{managerEmployeeId}}\",\n  \"hire_date\": \"{{hireDate}}\",\n  \"status\": \"{{employeeStatus}}\",\n  \"version\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Update Employee Status",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/employees/update-status/{{employeeId}}",
            "description": "Updates the selected employee status. Body is a JSON enum string such as \"ACTIVE\". Requires ADMIN or HR_MANAGER role.",
            "body": {
              "mode": "raw",
              "raw": "\"{{employeeStatus}}\"",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Update Employee Department",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/employees/update-department/{{employeeId}}",
            "description": "Moves the selected employee to another department. Body is a JSON UUID string. Requires ADMIN or HR_MANAGER role.",
            "body": {
              "mode": "raw",
              "raw": "\"{{departmentId}}\"",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Attendance",
      "description": "Check-in, check-out, attendance history, and monthly summary requests.",
      "item": [
        {
          "name": "Check In",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/attendance/check-in",
            "description": "Creates today's attendance record. Expected response: 201 Created.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"employeeId\": \"{{employeeId}}\",\n  \"checkInAt\": \"{{checkInAt}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Check Out",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/attendance/check-out",
            "description": "Checks out an employee who has already checked in on the same date.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"employeeId\": \"{{employeeId}}\",\n  \"checkOutAt\": \"{{checkOutAt}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Get Employee Attendance",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/attendance/employees/{{employeeId}}?from={{fromDate}}&to={{toDate}}",
            "description": "Lists an employee's attendance records in the selected date range."
          },
          "response": []
        },
        {
          "name": "Get Employee Monthly Summary",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/attendance/employees/{{employeeId}}/monthly-summary?year={{year}}&month={{month}}",
            "description": "Returns monthly attendance totals for an employee."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Reporting",
      "description": "Read-only reports populated from consumed domain events.",
      "item": [
        {
          "name": "Get Monthly Attendance Report",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/reports/attendance/monthly?year={{year}}&month={{month}}",
            "description": "Lists monthly attendance projections. Optional employeeId and departmentId filters can be added as query parameters."
          },
          "response": []
        },
        {
          "name": "Get Department Attendance Report",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/reports/departments/{{departmentId}}/attendance?year={{year}}&month={{month}}",
            "description": "Returns monthly attendance projections and totals for one department."
          },
          "response": []
        },
        {
          "name": "Get Employee Status Summary",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/reports/employees/status-summary?departmentId={{departmentId}}",
            "description": "Returns employee status counts for a department. Remove departmentId to query all departments."
          },
          "response": []
        },
        {
          "name": "Get Department Headcount",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/reports/departments/headcount",
            "description": "Returns active employee headcount grouped by department."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Notifications",
      "description": "List event-created notifications and mark them as read.",
      "item": [
        {
          "name": "List Notifications",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    if (Array.isArray(response.data) && response.data.length > 0) {",
                  "        pm.collectionVariables.set(\"notificationId\", response.data[0].id);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/notifications?recipientRole={{recipientRole}}&read={{notificationRead}}&type={{notificationType}}",
            "description": "Lists unread HR notifications of the selected type and saves the first result's ID to notificationId. recipientUserId is also supported as an optional query parameter."
          },
          "response": []
        },
        {
          "name": "Mark Notification As Read",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": "{{baseUrl}}/api/notifications/{{notificationId}}/read",
            "description": "Marks the selected notification as read. Run List Notifications first or set notificationId manually."
          },
          "response": []
        }
      ]
    }
  ],
